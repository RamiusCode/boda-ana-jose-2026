---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

import Portada from "../components/Portada.astro";
import NombresFlores from "../components/NombresFlores.astro";
import Dedicatoria from "../components/Dedicatoria.astro";
import NombresPadres from "../components/NombresPadres.astro";
import Fecha from "../components/Fecha.astro";
import DireccionCeremonia from "../components/DireccionCeremonia.astro";
import Itinerario from "../components/Itinerario.astro";
import Puntual from "../components/Puntual.astro";
import CodigoVestimenta from "../components/CodigoVestimenta.astro";
import SugerenciaRegalos from "../components/SugerenciaRegalos.astro";
import Despedida from "../components/Despedida.astro";
import FotoFinal from "../components/FotoFinal.astro";
import Confirmar from "../components/Confirmar.astro";
import GaleriaFotos from "../components/GaleriaFotos.astro";
import Pase from "../components/Pase.astro";
---

<Layout title="Ana Paola y José Alfredo">
    <Portada />
    <NombresFlores />
    <Dedicatoria />
    <NombresPadres />
    <Fecha />
    <DireccionCeremonia />
    <Itinerario />
    {/* Solo adultos: la invitación impresa no lo indica */}
    <!-- <Puntual /> -->
    <CodigoVestimenta />
    <SugerenciaRegalos />
    <GaleriaFotos />
    {/* Número de pases del invitado: cámbialo aquí para cada invitación */}
    <Pase pases={1} />
    <Confirmar />
    <Despedida />

    <!-- <FotoFinal /> -->
</Layout>
