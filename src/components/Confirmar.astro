---
// Confirmar.astro
const mensaje = encodeURIComponent(
    "Me complace confirmar mi asistencia a la boda de Ana Paola y José Alfredo. Nos vemos el sábado 28 de noviembre. ¡Estaré sin falta!",
);

// La impresa no trae un número para confirmar: se usan los celulares de la
// casa de la novia y la del novio que figuran en la tarjeta de regalos.
const contactos = [
    { etiqueta: "Confirmar con la novia", telefono: "59168213330" },
    { etiqueta: "Confirmar con el novio", telefono: "59171544550" },
];

// Para quien no puede ir: avisa y deja sus buenos deseos. El invitado puede
// editar el texto en WhatsApp antes de enviarlo. Llega a la novia.
const telefonoNoAsiste = "59168213330";
const mensajeNoAsiste = encodeURIComponent(
    "Queridos Ana Paola y José Alfredo, con mucha pena no podré acompañarlos el 28 de noviembre. Que Dios bendiga su matrimonio y les dé una vida llena de amor. ¡Muchas felicidades!",
);
---

<section id="confirmar" class="relative w-full py-10 px-6 text-center overflow-hidden isolate">

    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/paleta/florcostado.webp"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 right-0 w-[4.9rem] pointer-events-none select-none opacity-30 -translate-y-1/2 scale-x-[-1] z-[-1]"
    />
    <!-- SEPARADOR -->
    <img
        data-revelar="centro"
        src="/imagenes/paleta/separador.webp"
        alt=""
        aria-hidden="true"
        class="mx-auto mb-7 w-48"
    />

    <!-- TÍTULO -->
    <p data-revelar="arriba" class="font-romantic text-3xl text-[#DE8F8A] leading-snug">
        Confirmar Asistencia
    </p>

    <!-- TEXTO -->
    <p
        data-revelar="izquierda"
        class="font-cormorant italic text-xl text-[#3B5296] mt-4 leading-relaxed max-w-xs mx-auto"
    >
        Tu presencia es muy importante para nosotros. <br />Por favor,
        confírmanos tu asistencia.
    </p>

    <!-- BOTONES WHATSAPP -->
    <div data-revelar="derecha" class="flex flex-col items-center gap-4 mt-8">
        {
            contactos.map((contacto) => (
                <a
                    href={`https://wa.me/${contacto.telefono}?text=${mensaje}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full max-w-xs block py-3 px-6 rounded-full font-cormorant uppercase text-sm tracking-widest text-white bg-[#3F5AA6] hover:opacity-85 transition-opacity"
                >
                    {contacto.etiqueta}
                </a>
            ))
        }
    </div>

    <!-- NO PODRÁ ASISTIR: botón con borde, más discreto que los de confirmar -->
    <div data-revelar="abajo" class="flex flex-col items-center mt-8">
        <p class="font-cormorant italic text-xl text-[#3B5296]">
            ¿No podrás acompañarnos?
        </p>
        <a
            href={`https://wa.me/${telefonoNoAsiste}?text=${mensajeNoAsiste}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full max-w-xs block mt-3 py-3 px-6 rounded-full font-cormorant uppercase text-sm tracking-widest text-[#3F5AA6] bg-white border border-[#3F5AA6] hover:bg-[#eef1f9] transition-colors"
        >
            No podré asistir
        </a>
    </div>
</section>
