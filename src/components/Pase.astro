---
// Pase.astro
// Tarjeta con los pases asignados al invitado. El número que llega como prop
// es el de respaldo (index = 1, /pase1 … /pase5). Si el link trae ?i=código,
// el nombre y los pases se leen de la base y se pintan desde el script.
import { textosPase } from "../lib/pase";

export interface Props {
    pases?: number;
}

const { pases = 2 } = Astro.props;

const { etiqueta, frase } = textosPase(pases);
---

<section id="pases" class="relative w-full py-10 px-6 overflow-hidden isolate">
    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/paleta/florcostado.webp"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 left-0 w-[4.9rem] pointer-events-none select-none opacity-30 -translate-y-1/2 z-[-1]"
    />

    <div
        id="card-pases"
        data-revelar="abajo"
        class="relative bg-white rounded-3xl shadow-xl px-7 py-9 text-center max-w-xs mx-auto"
    >
        <!-- Marco rosado interior -->
        <div
            class="pointer-events-none absolute inset-3 rounded-2xl border"
            style="border-color: rgba(232,169,163,0.4);"
        >
        </div>

        <div class="relative">
            <!-- DEDICATORIA AL INVITADO: escondida hasta que llega el nombre
                 desde la base. Sin código en el link, o si el invitado no
                 existe, no se muestra ningún nombre. -->
            <div id="dedicatoria-invitado" style="display: none;">
                <p class="font-cormorant italic text-lg text-[#3B5296]">
                    Con mucho cariño para
                </p>
                <!-- No se fuerza a una sola línea: un nombre largo baja de
                     renglón en vez de achicarse. -->
                <p
                    id="nombre-invitado"
                    class="font-cormorant text-[1.6rem] text-[#263F86] leading-snug mt-1 mb-5"
                >
                </p>
            </div>

            <!-- BLOQUE DE PASES: se esconde solo si la boda tiene los pases apagados -->
            <div id="bloque-pases">
            <!-- ICONO DE PASES -->
            <img
                src="/imagenes/paleta/pase.png"
                alt=""
                aria-hidden="true"
                class="w-14 h-14 mx-auto"
            />

            <!-- TÍTULO -->
            <p
                class="font-cormorant uppercase tracking-[0.28em] text-base text-[#2F4FA2] mt-4"
            >
                Pases Asignados
            </p>

            <!-- DIVISOR con rombo rosado -->
            <div class="flex items-center justify-center gap-2 mt-3">
                <span
                    class="h-px w-10"
                    style="background-color: rgba(232,169,163,0.6);"></span>
                <span
                    class="w-1.5 h-1.5 rotate-45"
                    style="background-color: #E8A9A3;"></span>
                <span
                    class="h-px w-10"
                    style="background-color: rgba(232,169,163,0.6);"></span>
            </div>

            <!-- NÚMERO DE PASES -->
            <p
                id="numero-pases"
                class="font-charm font-bold text-6xl text-[#2F4FA2] leading-none mt-3"
            >
                {pases}
            </p>

            <!-- PASE / PASES -->
            <p
                id="palabra-pases"
                class="font-cormorant uppercase tracking-[0.3em] text-sm text-[#3B5296] mt-2"
            >
                {etiqueta}
            </p>

            <!-- DIVISOR inferior -->
            <div class="flex items-center justify-center gap-2 mt-3">
                <span
                    class="h-px w-10"
                    style="background-color: rgba(232,169,163,0.6);"></span>
                <span
                    class="w-1.5 h-1.5 rotate-45"
                    style="background-color: #E8A9A3;"></span>
                <span
                    class="h-px w-10"
                    style="background-color: rgba(232,169,163,0.6);"></span>
            </div>

            <!-- FRASE -->
            <p
                id="frase-pases"
                class="font-cormorant italic text-xl text-[#3B5296] mt-5 leading-relaxed"
            >
                {frase}
            </p>

            <!-- SILUETAS: una por pase -->
            <div
                id="iconos-pase"
                class="flex items-center justify-center gap-3 mt-6"
            >
                {
                    Array.from({ length: pases }).map(() => (
                        <span
                            class="w-9 h-9 rounded-full flex items-center justify-center"
                            style="background-color: #fbf0ee; border: 1px solid rgba(232,169,163,0.45);"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                class="w-5 h-5"
                                fill="#3F5AA6"
                                aria-hidden="true"
                            >
                                <circle cx="12" cy="8" r="3.6" />
                                <path d="M12 13.2c-3.6 0-6.4 2.2-6.4 4.9 0 .5.4.9.9.9h11c.5 0 .9-.4.9-.9 0-2.7-2.8-4.9-6.4-4.9z" />
                            </svg>
                        </span>
                    ))
                }
            </div>
            </div>
        </div>
    </div>
</section>

<script>
    // El link trae solo un código (?i=k7m2p); el nombre y los pases viven en
    // la base. Si los novios los corrigen en el panel, el link ya enviado
    // muestra lo corregido, incluso con la página abierta.
    import { datosInvitado, alCambiarInvitado } from "../lib/invitado";
    import type { Invitado } from "../lib/invitado";
    import { textosPase } from "../lib/pase";

    function pintarNombre(nombre: string | null | undefined) {
        const caja = document.getElementById("dedicatoria-invitado");
        const el = document.getElementById("nombre-invitado");
        const limpio = nombre ? nombre.trim() : "";
        if (el) el.textContent = limpio;
        if (caja) caja.style.display = limpio ? "" : "none";
    }

    function pintarPases(pases: unknown) {
        if (!Number.isInteger(pases) || (pases as number) <= 0) return;
        const n = pases as number;
        const { etiqueta, frase } = textosPase(n);

        const num = document.getElementById("numero-pases");
        const palabra = document.getElementById("palabra-pases");
        const textoFrase = document.getElementById("frase-pases");
        if (num) num.textContent = String(n);
        if (palabra) palabra.textContent = etiqueta;
        if (textoFrase) textoFrase.textContent = frase;

        // Una silueta por pase: se clona la primera para no repetir el SVG.
        const iconos = document.getElementById("iconos-pase");
        const molde = iconos?.firstElementChild;
        if (iconos && molde && iconos.children.length !== n) {
            const copias = Array.from({ length: n }, () =>
                molde.cloneNode(true),
            );
            iconos.replaceChildren(...copias);
        }
    }

    function mostrar(inv: Invitado | null) {
        // Sin invitado (link sin código, borrado o base caída) la tarjeta
        // queda con los pases de respaldo y sin nombre.
        if (!inv) return;

        pintarNombre(inv.nombre);

        // Si el panel apaga los pases, la tarjeta queda solo con el nombre.
        const funciones = (inv.funciones || {}) as { pases?: boolean };
        const bloque = document.getElementById("bloque-pases");
        if (funciones.pases === false) {
            if (bloque) bloque.style.display = "none";
            return;
        }
        if (bloque) bloque.style.display = "";
        pintarPases(inv.pases);
    }

    datosInvitado().then(mostrar);
    alCambiarInvitado((inv) => mostrar(inv));
</script>
