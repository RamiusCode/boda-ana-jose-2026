---
// SugerenciaRegalos.astro
// "Un detalle para nuestra nueva etapa": las dos casas donde se puede dejar
// un obsequio y el QR para transferir. Los datos salen de la tarjeta impresa.
const casas = [
    {
        titulo: "Casa Novia",
        revelar: "izquierda",
        direccion: "Calle 24 de Calacoto Nro. 2<br />Edificio Vdara Residence",
        celular: "682 13 330",
    },
    {
        titulo: "Casa Novio",
        revelar: "derecha",
        direccion: "Calle Cnl. J. Valdez Nro. 1249<br />Zona Villa Pabón",
        celular: "715 44 550",
    },
];

// QR original del banco (lleva el mismo contenido que el impreso). Se ofrece
// para descargar porque desde el celular no se puede escanear la propia
// pantalla: hay que subir la imagen a la app del banco.
const qr = "/imagenes/qr.png";
---

<section
    id="sugerencia-regalos"
    class="relative w-full py-10 px-6 text-center overflow-hidden isolate"
>
    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/paleta/florcostado.webp"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 -left-12 w-40 pointer-events-none select-none opacity-30 -translate-y-1/2 z-[-1]"
    />

    <!-- TÍTULO -->
    <p
        data-revelar="arriba"
        class="font-cormorant uppercase tracking-[0.28em] text-base font-semibold text-[#2F4FA2]"
    >
        Un detalle para
    </p>
    <p
        data-revelar="arriba"
        class="font-romantic text-3xl text-[#DE8F8A] leading-snug mt-2 mb-6"
    >
        Nuestra nueva etapa
    </p>

    <!-- ICONO REGALO -->
    <svg
        data-revelar="centro"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 64 64"
        fill="none"
        class="w-14 h-14 mx-auto"
        stroke="#3F5AA6"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <!-- Caja del regalo -->
        <rect x="8" y="28" width="48" height="30" rx="3"></rect>
        <!-- Tapa -->
        <rect x="6" y="20" width="52" height="10" rx="3"></rect>
        <!-- Lazo vertical -->
        <line x1="32" y1="20" x2="32" y2="58"></line>
        <!-- Lazo horizontal (tapa) -->
        <line x1="6" y1="25" x2="58" y2="25"></line>
        <!-- Moño izquierdo -->
        <path d="M32,20 C28,14 18,14 20,20 C22,26 32,20 32,20Z"></path>
        <!-- Moño derecho -->
        <path d="M32,20 C36,14 46,14 44,20 C42,26 32,20 32,20Z"></path>
    </svg>

    <!-- TEXTO PRINCIPAL: la presencia por delante del obsequio -->
    <p
        data-revelar="izquierda"
        class="font-cormorant italic text-[1.35rem] text-[#3B5296] mt-6 leading-[1.9] max-w-xs mx-auto"
    >
        Lo más importante para nosotros es compartir este día contigo. Si
        deseas tener un detalle con nosotros, hemos habilitado estas opciones
        para quienes nos han preguntado.
    </p>

    <!-- PANELES: una casa por panel -->
    {
        casas.map((casa) => (
            <div
                data-revelar={casa.revelar}
                class="relative max-w-xs mx-auto mt-8 rounded-3xl px-7 py-8 shadow-md"
                style="background: linear-gradient(160deg, #fdf8f7 0%, #f9ebe8 100%); border: 1px solid rgba(232,169,163,0.35);"
            >
                {/* Marco rosado interior */}
                <div
                    class="pointer-events-none absolute inset-2.5 rounded-2xl border"
                    style="border-color: rgba(232,169,163,0.4);"
                />

                <div class="relative flex flex-col items-center">
                    <p class="font-upcil uppercase text-2xl text-[#2F4FA2]">
                        {casa.titulo}
                    </p>

                    {/* ORNAMENTO: rombo entre líneas */}
                    <div class="flex items-center justify-center gap-2 mt-3">
                        <span
                            class="h-px w-10"
                            style="background-color: rgba(232,169,163,0.6);"
                        />
                        <span
                            class="w-1.5 h-1.5 rotate-45"
                            style="background-color: #E8A9A3;"
                        />
                        <span
                            class="h-px w-10"
                            style="background-color: rgba(232,169,163,0.6);"
                        />
                    </div>

                    <p
                        class="font-cormorant italic text-[1.35rem] text-[#3B5296] mt-4 leading-relaxed"
                        set:html={casa.direccion}
                    />

                    <a
                        href={`tel:+591${casa.celular.replace(/\s/g, "")}`}
                        class="font-cormorant text-xl text-[#2F4FA2] mt-3"
                    >
                        Cel. {casa.celular}
                    </a>
                </div>
            </div>
        ))
    }

    <!-- PANEL DEL QR: transferencia bancaria -->
    <div
        data-revelar="abajo"
        class="relative max-w-xs mx-auto mt-8 rounded-3xl px-7 py-8 shadow-md"
        style="background: linear-gradient(160deg, #fdf8f7 0%, #f9ebe8 100%); border: 1px solid rgba(232,169,163,0.35);"
    >
        <!-- Marco rosado interior -->
        <div
            class="pointer-events-none absolute inset-2.5 rounded-2xl border"
            style="border-color: rgba(232,169,163,0.4);"
        >
        </div>

        <div class="relative flex flex-col items-center">
            <p
                class="font-cormorant italic text-[1.35rem] text-[#3B5296] leading-relaxed"
            >
                Si prefieres hacerlo de forma digital
            </p>

            <img
                src={qr}
                alt="QR para transferencia bancaria"
                width="636"
                height="639"
                loading="lazy"
                decoding="async"
                class="w-48 h-48 mt-4 rounded-xl bg-white"
            />

            <p
                class="font-cormorant uppercase tracking-[0.18em] text-xs text-[#3B5296] mt-3 leading-relaxed"
            >
                Transferencia bancaria<br />Banco de Crédito
            </p>

            <!-- BOTÓN para guardar el QR en el celular -->
            <a
                href={qr}
                download="qr-ana-paola-y-jose-alfredo.png"
                class="inline-flex items-center gap-2 mt-5 py-2.5 px-7 rounded-full font-cormorant uppercase text-xs tracking-widest text-white bg-[#3F5AA6] shadow-md hover:bg-[#2F4A93] transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path d="M12 3a1 1 0 0 1 1 1v9.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.4l3.3 3.3V4a1 1 0 0 1 1-1zM5 19h14a1 1 0 1 1 0 2H5a1 1 0 1 1 0-2z" />
                </svg>
                Descargar QR
            </a>
        </div>
    </div>
</section>
