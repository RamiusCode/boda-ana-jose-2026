---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-50 overflow-hidden"
    style="background-color: #f0d2cd;"
>
    <!-- SOBRE - fondo que ocupa todo el ancho de la pantalla -->
    <img
        id="sobre-img"
        src="/imagenes/paleta/sobre.webp"
        alt="Sobre de invitación"
        fetchpriority="high"
        decoding="sync"
        class="absolute top-0 left-0 w-full h-full object-cover object-top"
    />

    <!-- TEXTO SUPERIOR - ¡NOS CASAMOS! en dorado, como los anillos del sello -->
    <div
        id="texto-superior"
        class="absolute top-[8%] left-0 right-0 text-center z-20 px-6"
    >
        <p
            class="font-cormorant uppercase tracking-[0.3em] text-2xl md:text-3xl font-semibold"
            style="color: #A47A1C;"
        >
            ¡Nos Casamos!
        </p>
    </div>

    <!-- SELLO / BOTÓN - centrado sobre la imagen -->
    <div class="absolute inset-0 flex items-center justify-center z-20">
        <button
            id="btn-sello"
            class="cursor-pointer transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
        >
            <img
                src="/imagenes/paleta/boton2.webp"
                alt="Sello con anillos"
                width="512"
                height="557"
                fetchpriority="high"
                class="w-28 h-28 md:w-32 md:h-32"
                style="filter: drop-shadow(0 5px 16px rgba(47, 79, 162, 0.32));"
            />
        </button>
    </div>

    <!-- TEXTO - posicionado sobre la portada -->
    <div
        id="texto-portada"
        class="absolute bottom-[11%] [@media(max-height:700px)]:bottom-[5%] md:bottom-[7%] left-0 right-0 text-center z-20 px-6 flex flex-col items-center"
    >
        <p
            class="font-cormorant uppercase tracking-[0.32em] text-sm md:text-base font-semibold"
            style="color: #263F86;"
        >
            DALE CLIC AL SELLO
        </p>
        <p
            class="font-cormorant uppercase tracking-normal text-sm md:text-base font-medium mt-0.5"
            style="color: #263F86;"
        >
            PARA INGRESAR A LA INVITACIÓN
        </p>
        <p
            class="font-crimson italic text-xl md:text-2xl mt-4"
            style="color: #A47A1C;"
        >
            Atentamente:
        </p>
        <h2
            class="font-romantic text-3xl md:text-4xl mt-4 leading-tight whitespace-nowrap"
            style="color: #2F4FA2;"
        >
            {/* Azul rey, el del sello: el rosa se perdía sobre el sobre palo de rosa. */}
            {/* Un nombre por línea y la y en la suya, como en la impresa. */}
            Ana Paola<br /><span class="font-romantic" style="color: #A47A1C; font-size: 0.82em;">y</span><br />José Alfredo
        </h2>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Bloqueo del scroll por estilo en línea (siempre gana y no depende del CSS).
    // Se hace ya, sin esperar a DOMContentLoaded, para que no se pueda desplazar
    // la página por detrás del sobre.
    function bloquearScroll(bloquear: boolean) {
        const v = bloquear ? "hidden" : "";
        document.documentElement.style.overflow = v;
        document.body.style.overflow = v;
    }
    bloquearScroll(true);

    // Las fotos no declaran alto: al terminar de cargar, la página cambia de
    // tamaño y ScrollTrigger queda con medidas viejas. Recalcular.
    window.addEventListener("load", () => ScrollTrigger.refresh());

    document.addEventListener("DOMContentLoaded", () => {
        const btnSello = document.getElementById("btn-sello");
        const portada = document.getElementById("portada-sobre");

        // Entrada del sello con efecto elástico
        gsap.from("#btn-sello", {
            scale: 0.8,
            duration: 1.5,
            ease: "elastic.out(1, 0.5)",
            delay: 0.5,
        });

        // Respiración continua del sello
        gsap.to("#btn-sello", {
            scale: 1.05,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        // Entrada suave del texto inferior
        gsap.from("#texto-portada", {
            opacity: 0,
            y: 18,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.4,
        });

        // Entrada del texto superior ¡Nos Casamos!
        gsap.from("#texto-superior", {
            opacity: 0,
            y: -16,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.3,
        });

        btnSello?.addEventListener("click", () => {
            const audio = new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });

            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            setTimeout(() => {
                const iconoPlay = document.getElementById("icono-play");
                const iconoPause = document.getElementById("icono-pause");

                if (iconoPlay && iconoPause) {
                    iconoPlay.classList.add("hidden");
                    iconoPause.classList.remove("hidden");
                }
            }, 100);

            // Liberar el scroll YA. Antes se liberaba, pero el sobre seguía
            // encima 0.8s capturando el toque: el primer deslizamiento no
            // hacía nada y había que repetirlo.
            if (portada) portada.style.pointerEvents = "none";
            bloquearScroll(false);
            window.scrollTo(0, 0);

            gsap.to(portada, {
                opacity: 0,
                duration: 0.6,
                ease: "power2.out",
                onComplete: () => {
                    portada?.remove();
                    ScrollTrigger.refresh();
                },
            });
        });
    });
</script>
